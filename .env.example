# Configuración de variables de entorno
# Copia este archivo a .env y actualiza los valores

# ==================== BACKEND (Raspberry Pi) ====================

# Puerto del servidor API
BACKEND_PORT=8000

# Host (0.0.0.0 para aceptar conexiones externas)
BACKEND_HOST=0.0.0.0

# ==================== FRONTEND (Streamlit Cloud) ====================

# URL del backend API en la Raspberry
# Opciones:
# - IP local: http://192.168.1.100:8000
# - Tailscale: http://100.x.x.x:8000
# - DuckDNS: http://tu-dominio.duckdns.org:8000
# - ngrok: https://xxxx-xx-xx-xx-xx.ngrok.io

BACKEND_API_URL=http://localhost:8000

# ==================== SEGURIDAD ====================

# API Key para autenticación (opcional, para implementar)
# API_KEY=your-secret-key-here

# ==================== NOTIFICACIONES ====================

# Email notifications (opcional)
ENABLE_EMAIL_NOTIFICATIONS=false
GMAIL_USER=tu-email@gmail.com
GMAIL_APP_PASSWORD=tu-contraseña-de-app
RECIPIENT_EMAIL=destinatario@gmail.com
